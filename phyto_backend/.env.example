# ─── MySQL (Aiven / local) ─────────────────────────────────────────────
# Option A (recommended): split DB variables (supports SSL CA cert cleanly)
DB_USER=avnadmin
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=phyto
DB_SSL_CA=

# Option B (legacy): full URL (kept for backward compatibility)
# MYSQL_URL=mysql+aiomysql://root:password@localhost/phyto
MYSQL_URL=

# ─── MongoDB Atlas ─────────────────────────────────────────────────────
# Example:
# MONGODB_URL=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?appName=Phyto
MONGODB_URL=
MONGODB_DB_NAME=phyto_db

# ─── App Security / Web ────────────────────────────────────────────────
SECRET_KEY=REPLACE_WITH_GENERATED_64_CHAR_HEX_STRING
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,https://phyto.web.app
TREFLE_API_TOKEN=

